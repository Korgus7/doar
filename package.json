{
  "name": "doar",
  "productName": "Doar Mail",
  "version": "0.4.0",
  "description": "Jednoduchý e-mailový klient pre desktop (IMAP/SMTP) so zálohou do mbox.",
  "license": "MIT",
  "author": "Milan Caputa",
  "homepage": "https://github.com/Korgus7/doar",
  "repository": {
    "type": "git",
    "url": "https://github.com/Korgus7/doar.git"
  },
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.preload.json && svelte-check --tsconfig tsconfig.web.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "testserver": "node scripts/testserver.mjs",
    "rebuild:electron": "echo nič na zostavenie",
    "dist": "electron-vite build && electron-builder --win --publish never && node scripts/release-manifest.mjs"
  },
  "dependencies": {
    "imapflow": "^2.5.9",
    "mailparser": "^3.10.0",
    "nodemailer": "^10.1.7",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tanstack/svelte-virtual": "^3.13.47",
    "@tiptap/core": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "electron": "^45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^6.0.0",
    "smtp-server": "^3.20.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
