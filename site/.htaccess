# Stránka Doar Mail: tlačidlo „Stiahnuť“ si zisťuje najnovšie vydanie z GitHubu (api.github.com).
# Nahrádza bezpečnostnú hlavičku (CSP) nadradeného webu len pre tento priečinok.
<IfModule mod_headers.c>
  Header unset Content-Security-Policy
  Header always unset Content-Security-Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src https://api.github.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
</IfModule>
